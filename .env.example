# APP_URL: The URL where this application is hosted.
APP_URL="https://scanlinksm.up.railway.app"

# Server Port (defaults to 3000)
PORT=3000

# External Threat Intelligence Provider Keys (Backend-only, never expose to frontend)
# Leave blank if not configured; the platform reports provider status accurately. Set real keys in runtime .env only.
VIRUSTOTAL_API_KEY=""
URLHAUS_AUTH_KEY=""
URLSCAN_API_KEY=""
OTX_API_KEY=""

# ScreenshotNeo Capture Service (Backend-only)
SCREENSHOTNEO_ACCESS_KEY=""

# External Cloud Browser Service (Level B Dynamic Execution & Screenshot Capture, Backend-only)
# Leave blank if not configured; never expose endpoints or keys to the frontend or reports.
CLOUD_BROWSER_ENDPOINT=""
CLOUD_BROWSER_API_KEY=""
CLOUD_BROWSER_TIMEOUT_MS=20000

# Security & Rate Limiting
SCAN_RATE_LIMIT_MAX=20
SCAN_RATE_LIMIT_WINDOW_MS=60000
ALLOWED_ORIGINS="https://scanlinksm.up.railway.app"
